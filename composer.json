{
  "name": "poseidon/code-graph-parser-php",
  "description": "Native PHP process parser for code-graph-engine",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "nikic/php-parser": "^5.0",
    "poseidon/static-extract-php": "dev-main"
  },
  "repositories": [
    {"type": "path", "url": "../static-extract-php", "options": {"symlink": true}}
  ],
  "autoload": {
    "psr-4": {"Poseidon\\CodeGraphParserPhp\\": "src/"}
  },
  "autoload-dev": {
    "psr-4": {"Poseidon\\CodeGraphParserPhp\\Tests\\": "tests/"}
  },
  "require-dev": {"phpunit/phpunit": "^11.0"},
  "scripts": {"test": "phpunit"},
  "bin": ["bin/parser-php"]
}
