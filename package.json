  "dependencies": {
    "@static-extract/extractor-php": "file:../static-extract-php",
    "php-parser": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
