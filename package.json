{
  "name": "code-graph-parser-php",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PHP static code graph parser using the code-graph-engine process protocol.",
  "bin": {
    "code-graph-parser-php": "./dist/cli.js"
  },
  "scripts": {
